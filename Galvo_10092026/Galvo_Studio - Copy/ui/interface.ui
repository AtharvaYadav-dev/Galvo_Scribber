   <property name="styleSheet">
    <string notr="true">*{
	border: none;
	background-color:transparent;
	padding: 0;
	margin: 0;
	color: #fff;
}

#centralwidget {
	background-color: rgb(31, 35, 42);
}

#leftMenuSubContainer {	
	background-color: rgb(16, 42, 131);
}

#leftMenuSubContainer QPushButton {
	text-align: left;
	padding: 5px 10px;
	border-top-left-radius: 10px;
	border-bottom-left-radius: 10px;
}

#centerMenuFrame {
	background-color: rgb(16, 42, 131);
	border-radius: 20px;
}

#notifySubContainer {	
	background-color: rgb(22, 25, 29);
	border-radius: 10px;
}

#headerContainer, #footerContainer {
	background-color: rgb(16, 42, 131);
}

#centerSlideMenu {
	background-color: rgb(167, 198, 229);	
}

#helpLabel, #infoLabel, #settingsLabel, #profileLabel {
	color: rgb(16, 42, 131);
}

#mainBodyContent {
	background-color: rgb(144, 170, 197);
}

#infoSubFrame, #comFrame, #jogFrame, #setFrame, #profilesubFrame {
	background-color: rgb(144, 170, 197);
	border-radius: 20px;
}

#jogFrame, #laserconfFrame, #programFrame, #recipeFrame, #printFrame, #terminalFrame, #cameraFrame {
	background-color: rgb(167, 198, 229);
	border-radius: 20px;
}

#homeFrame, #stepsFrame, #xyFrame, #zFrame, #axisposFrame, #setfocusFrame, #flaserFrame, #zfocusFrame, #fsetFrame, #loffsetFrame, #offlaserFrame, #xyoffsetFrame, #xyposFrame, #offsetFrame, #offbtnFrame, #progFrame, #rcpFrame, #printimgFrame, #printopFrame, #printprogramFrame, #printprogressFrame, #camFrame, #cameraxyoffFrame, #objheightFrame{
	background-color: rgb(144, 170, 197);
	border-radius: 20px;
	border: 2px solid rgb(16, 42, 131);
}
</string>
