                             <string notr="true">QPushButton {
	color: rgb(255, 255, 255);	
	background-color: rgb(16, 42, 131);
	border-color: transparent;
	border-style: outset;
	border-radius: 20px;
	border-width: 2px;
	
	/* --- THE ICON SETTINGS --- */
	background-image: url(:/icons/icons/aperture.svg); 
	background-repeat: no-repeat;
	background-position: center 8px; 
	
	/* --- PUSHES TEXT DOWN TO MAKE ROOM FOR ICON --- */
	padding-top: 55px;  /* Increased to 55px to add space between icon and text */
	padding-bottom: 6px;
	padding-left: 6px;
	padding-right: 6px;
	text-align: center;
}

QPushButton:hover {
	color: rgb(16, 42, 131);
	background-color: rgb(167, 198, 229);
	border-color: rgb(16, 42, 131);
}

QPushButton:disabled {
	background-color: rgb(172, 172, 172);
}
</string>
